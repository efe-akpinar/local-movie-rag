# Copy to .env for docker compose. Never commit .env.

# Generator: groq | local | fake (fake needs no key and is handy for a first run)
LLM_PROVIDER=fake
# Required when LLM_PROVIDER=groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Requests per minute per client IP on /ask; 0 disables the limit (useful for load tests)
RATE_LIMIT_PER_MINUTE=20
# Comma-separated origins allowed to call the API from a browser on another domain
CORS_ORIGINS=
# Gunicorn workers; each loads its own copy of the models
WEB_CONCURRENCY=1
LOG_LEVEL=INFO

# Grafana admin login (anonymous viewers can already see the dashboard)
GRAFANA_ADMIN_PASSWORD=change-me
